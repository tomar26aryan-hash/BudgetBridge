# Copy this file to ".env" for local development:   cp .env.example .env
# In production (Render etc.) set these in the hosting dashboard instead -
# NEVER commit a real .env file.

# --- Server -------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Long random string used to sign login tokens. REQUIRED in production (32+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Database: option A (recommended for hosting) -----------------------
# Paste the "Service URI" from Aiven / Railway / etc.
# DATABASE_URL=mysql://user:password@host:port/database?ssl-mode=REQUIRED

# --- Database: option B (local MySQL) -----------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=budgetbridge

# --- Database SSL (needed by most managed providers) --------------------
# DB_SSL=true                # encrypted connection, certificate not verified
# DB_CA_CERT=                # paste the provider's CA certificate (PEM) to also verify it

# --- Only if the frontend is hosted on a DIFFERENT domain ---------------
# Comma-separated list of allowed origins, no trailing slash.
# CLIENT_URL=https://budgetbridge.vercel.app
